<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.onlineclassroom.mapper.SysRoleReadMapper">

    <select id="countByKeyword" resultType="long">
        select count(*)
        from sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                name like concat('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="selectPage" resultType="jack.digityhuman.onlineclassroom.entity.SysRoleRead">
        select id, name, remark
        from sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                name like concat('%', #{keyword}, '%')
            </if>
        </where>
        order by id
        limit #{offset}, #{limit}
    </select>
</mapper>
