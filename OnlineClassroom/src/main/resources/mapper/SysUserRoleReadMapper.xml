<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.onlineclassroom.mapper.SysUserRoleReadMapper">

    <select id="countByRoleIds" resultType="jack.digityhuman.onlineclassroom.dto.KngReadDtos$RoleCountRow">
        select role_id, count(*) user_count
        from sys_user_role
        where role_id in
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        group by role_id
    </select>
</mapper>
