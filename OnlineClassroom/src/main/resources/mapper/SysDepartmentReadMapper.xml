<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.onlineclassroom.mapper.SysDepartmentReadMapper">

    <sql id="departmentColumns">
        id, dept_code, dept_name, parent_path, dept_path, dept_level, sort, user_count
    </sql>

    <select id="selectAllOrdered" resultType="jack.digityhuman.onlineclassroom.entity.SysDepartmentRead">
        select <include refid="departmentColumns"/>
        from sys_department
        order by sort, id
    </select>

    <select id="selectByIds" resultType="jack.digityhuman.onlineclassroom.entity.SysDepartmentRead">
        select <include refid="departmentColumns"/>
        from sys_department
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectFirstLevel" resultType="jack.digityhuman.onlineclassroom.entity.SysDepartmentRead">
        select <include refid="departmentColumns"/>
        from sys_department
        where dept_level = 1
        order by sort, id
    </select>

    <select id="selectById" resultType="jack.digityhuman.onlineclassroom.entity.SysDepartmentRead">
        select <include refid="departmentColumns"/>
        from sys_department
        where id = #{id}
        limit 1
    </select>
</mapper>
