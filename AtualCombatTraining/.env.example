# AtualCombatTraining（8082）
# 必填：缺失时启动失败
ACT_DB_PASSWORD=

# 可选：Dify / DashScope（未配置时相关功能降级）
ACT_DIFY_ORCHESTRATOR_KEY=
ACT_DIFY_THEME_GEN_KEY=
ACT_DIFY_CASE_GEN_KEY=
ACT_DASHSCOPE_API_KEY=

# Shared service-to-service auth for AIGentService / internal memory
AGENT_INTERNAL_TOKEN=
AGENT_INTERNAL_AUTH_ENABLED=true

# 说明：真实值放系统环境变量或本机未跟踪的 .env，不要提交。
