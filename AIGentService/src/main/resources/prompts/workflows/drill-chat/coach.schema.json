{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://final-dream.local/schemas/drill-chat-coach-v1.schema.json",
  "title": "DrillChatCoachV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coachReview", "targetProgress", "deltaReason", "behaviorHits"],
  "properties": {
    "coachReview": { "type": "string", "minLength": 1 },
    "targetProgress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "deltaReason": { "type": "string" },
    "behaviorHits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
