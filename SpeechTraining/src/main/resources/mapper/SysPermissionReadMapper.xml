<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.speechtraining.mapper.SysPermissionReadMapper">
    <select id="selectByIds" resultType="jack.digityhuman.speechtraining.entity.SysPermissionRead">
        select id, code
        from sys_permission
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by code
    </select>
</mapper>
