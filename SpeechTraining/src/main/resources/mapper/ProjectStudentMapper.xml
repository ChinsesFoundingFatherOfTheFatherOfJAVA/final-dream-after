<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.speechtraining.mapper.ProjectStudentMapper">
    <!-- 覆盖人次：distinct user_id 全量统计（不按区间），作为学习率/完成率的分母（01-需求文档.md 第 2.3 节） -->
    <select id="countDistinctUsers" resultType="long">
        select count(distinct user_id)
        from project_student
    </select>
</mapper>
