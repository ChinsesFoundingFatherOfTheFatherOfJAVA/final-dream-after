<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.speechtraining.mapper.TrainingSessionMapper">
    <select id="selectForUpdate" resultType="jack.digityhuman.speechtraining.entity.TrainingSession">
        select *
        from training_session
        where id = #{sessionId}
        for update
    </select>
</mapper>
