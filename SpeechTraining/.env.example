# SpeechTraining（8081）
# 必填：缺失时启动失败
SPEECH_DB_PASSWORD=
SPEECH_AUTH_JWT_SECRET=

# 可选：AI 能力（未配置时相关功能返回未配置，不影响启动）
SPEECH_DIFY_SCORING_KEY=
SPEECH_DIFY_REPORT_SCORING_KEY=
SPEECH_DIFY_AVATAR_GEN_KEY=
SPEECH_DIFY_GEN_SCENE_KEY=
SPEECH_DIFY_GEN_OUTLINE_KEY=
SPEECH_DIFY_GEN_SCRIPT_KEY=
SPEECH_DASHSCOPE_API_KEY=
SPEECH_TONE_API_KEY=
SPEECH_DOUBAO_APP_KEY=
SPEECH_DOUBAO_ACCESS_KEY=

# Shared service-to-service auth for AIGentService native workflows
AGENT_INTERNAL_TOKEN=

# 说明：真实值放系统环境变量或本机未跟踪的 .env，不要提交。
