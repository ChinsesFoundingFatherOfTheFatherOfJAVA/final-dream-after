<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.staffmanagement.mapper.SysPermissionMapper">
    <select id="selectRowsByIds" resultType="jack.digityhuman.staffmanagement.entity.SysPermission">
        select id, code, name, parent_id, route_path, sort
        from sys_permission
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by sort, id
    </select>
</mapper>
