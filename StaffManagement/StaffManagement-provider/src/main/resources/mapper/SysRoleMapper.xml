<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.staffmanagement.mapper.SysRoleMapper">
    <select id="selectRoles" resultType="jack.digityhuman.staffmanagement.entity.SysRole">
        select id, name, description, remark, built_in, created_by, created_at
        from sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                name like concat('%', #{keyword}, '%')
            </if>
        </where>
        order by id
    </select>

    <select id="selectRowsByIds" resultType="jack.digityhuman.staffmanagement.entity.SysRole">
        select id, name, description, remark, built_in, created_by, created_at
        from sys_role
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id
    </select>
</mapper>
