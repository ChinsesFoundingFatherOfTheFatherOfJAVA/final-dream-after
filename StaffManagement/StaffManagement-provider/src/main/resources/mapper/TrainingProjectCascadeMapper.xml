<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jack.digityhuman.staffmanagement.mapper.TrainingProjectCascadeMapper">
    <select id="countProtectedProjects" resultType="int">
        select count(*)
        from training_project
        where responsible_person = #{account}
           or created_by = #{account}
    </select>
</mapper>
